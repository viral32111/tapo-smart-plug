# The minimum level of logs to print
TAPO_LOG_LEVEL = "info"

# The IP address & TCP port to listen for HTTP requests on
TAPO_HTTP_ADDRESS = "127.0.0.1"
TAPO_HTTP_PORT = 5000

# The HTTP path to expose Prometheus metrics on
TAPO_METRICS_PATH = "/metrics"

# Whether to also expose metrics for the Go process
TAPO_METRICS_GO_BUILTIN = false

# The interval to poll each smart plug at
TAPO_METRICS_INTERVAL = "10s"

# The global TP-Link Tapo account credentials, required unless set in the config file
TAPO_ACCOUNT_EMAIL = ""
TAPO_ACCOUNT_PASSWORD = ""
